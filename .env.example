# Par défaut : modèle local (aucune clé nécessaire)
LLM_PROVIDER=local
LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_QUANT=int8-mlp          # ou none (float32, ~6,5 Go de RAM pour 1.5B)
NUM_THREADS=2

# Pour brancher une API compatible OpenAI (OpenAI, Groq, Mistral, Ollama, vLLM…) :
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=...             # (ou OPENAI_API_KEY / GROQ_API_KEY)
